# Copy this file to .env and fill in your key. .env is git-ignored, never commit it.
GEMINI_API_KEY=your_key_here

# Optional: Google Safe Browsing lookups (Lookup API v4, non-commercial use)
# GOOGLE_SAFE_BROWSING_API_KEY=your_safe_browsing_key

# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite
# RATE_LIMIT_PER_MIN=10
# DAILY_REQUEST_CAP=500
# MAX_TEXT_CHARS=4000
# MAX_IMAGE_MB=5
